{
  "name": "business-accounting-pro",
  "version": "1.4.0",
  "productName": "Business Accounting Pro",
  "description": "Professional business accounting software for income, expenses, taxes, payroll, invoicing and more",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently \"vite --config vite.config.ts\" \"wait-on http://localhost:5173 && NODE_ENV=development electron .\"",
    "build:renderer": "vite build --config vite.config.ts",
    "build:main": "tsc -p tsconfig.main.json && cp src/main/database/schema.sql dist/main/main/database/schema.sql",
    "build": "npm run build:renderer && npm run build:main",
    "typecheck": "tsc --noEmit --project tsconfig.main.json && tsc --noEmit --project tsconfig.json",
    "gen:channels": "tsx scripts/gen-ipc-channels.ts",
    "gen:channels:check": "tsx scripts/gen-ipc-channels.ts --check",
    "lint": "eslint . --max-warnings=100000",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.{ts,js}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "test:watch": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs",
    "test:coverage": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --coverage",
    "test:loan": "npm test -- loan-calculator",
    "test:payment": "npm test -- payment-math",
    "test:depreciation": "npm test -- depreciation",
    "test:attachments": "npm test -- document-storage",
    "test:search": "npm test -- searchIndex",
    "test:cockpit": "npm test -- layout-utils",
    "test:classic": "npm test -- classic-styles",
    "test:micr": "npm test -- micr",
    "test:migrations": "npm test -- migrations",
    "prepare": "git config core.hooksPath scripts/git-hooks || true",
    "postinstall": "electron-builder install-app-deps",
    "dist": "npm run build && electron-builder",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "start": "electron .",
    "deploy": "bash scripts/deploy.sh",
    "build:web": "vite build --config vite.web.config.ts",
    "deploy:web": "npm run build:web && cd cloudflare-app && npx wrangler deploy --env=''"
  },
  "keywords": [
    "accounting",
    "business",
    "finance",
    "payroll",
    "invoicing"
  ],
  "author": "RMPG",
  "license": "ISC",
  "type": "commonjs",
  "overrides": {
    "js-yaml": ">=4.2.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.2",
    "@types/archiver": "^7.0.0",
    "@types/qrcode": "^1.5.6",
    "archiver": "^7.0.1",
    "better-sqlite3": "^12.11.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "tesseract.js": "^7.0.0",
    "uuid": "^13.0.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.4",
    "electron": "^41.8.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "lint-staged": "^15.5.2",
    "lucide-react": "^1.21.0",
    "postcss": "^8.5.15",
    "prettier": "^3.9.10",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "terser": "^5.48.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.16",
    "vitest": "^3.2.7",
    "wait-on": "^9.0.10",
    "zustand": "^5.0.14"
  }
}
