  "version": "0.0.1",
  "configurations": [
    {
      "name": "Vite Renderer",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "build:renderer"],
      "port": 5173
    },
    {
      "name": "Vite Dev Server",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": ["/Users/rmpgutah/Business Accounting Pro/node_modules/.bin/vite", "--config", "vite.config.ts"],
      "port": 5173
    },
    {
      "name": "Landing Page",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": ["-e", "require('http').createServer((req,res)=>{const fs=require('fs'),path=require('path');let f=path.join('/Users/rmpgutah/Business Accounting Pro/landing-page',req.url==='/'?'index.html':req.url);fs.readFile(f,(e,d)=>{if(e){res.writeHead(404);res.end();}else{const ext=path.extname(f);const ct={'html':'text/html','svg':'image/svg+xml'}[ext.slice(1)]||'text/plain';res.writeHead(200,{'Content-Type':ct});res.end(d);}});}).listen(8080)"],
      "port": 8080
    },
    {
      "name": "Vendor Preview",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": ["-e", "require('http').createServer((req,res)=>{const fs=require('fs');const f=req.url==='/docs'?'/tmp/docs-preview.html':'/tmp/vendor-preview.html';fs.readFile(f,(e,d)=>{if(e){res.writeHead(404);res.end();}else{res.writeHead(200,{'Content-Type':'text/html'});res.end(d);}});}).listen(8082)"],
      "port": 8082
    }
  ]
